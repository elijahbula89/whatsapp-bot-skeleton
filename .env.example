# Copy this file to .env and fill it in. Never share or commit .env.

# From console.anthropic.com > API keys
ANTHROPIC_API_KEY=

# Meta: developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
# Meta: App settings > Basic > App secret
WHATSAPP_APP_SECRET=
# Any secret word you choose; type the same word into Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=

# Optional
# CLAUDE_MODEL=claude-sonnet-5
# WHATSAPP_GRAPH_VERSION=v23.0
